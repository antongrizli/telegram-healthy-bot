# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# AI Provider: "gemini" or "openrouter"
AI_PROVIDER=gemini

# Gemini API Credentials (obtain from Google AI Studio)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemma-4-31b-it

# OpenRouter Credentials (optional alternative provider, obtain from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-YourOpenRouterApiKeyHere
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Optional diagnostic request before photo analysis; uses an additional quota reservation.
AI_COUNT_TOKENS=false

# Provider attempts (including retries), configurable for your API plan
AI_REQUESTS_PER_MINUTE=15
AI_REQUESTS_PER_DAY=1500
AI_USER_REQUESTS_PER_MINUTE=5
AI_QUEUE_MAX_RETRIES=8

# List of Telegram user IDs with Admin privileges (comma-separated)
ADMIN_USER_IDS=987654321,123456789

# Database URL configuration (points to localhost for local testing, overridden in docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/healthy_bot

# Postgres config (used by docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=healthy_bot

# WebApp URL
WEBAPP_URL=https://your-public-domain.com/webapp/

# Force IPv6 connection for Telegram API (useful if IPv4 timeouts occur)
FORCE_IPV6=false
